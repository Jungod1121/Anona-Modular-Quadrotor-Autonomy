<?xml version="1.0"?>
<package format="3">
  <name>drone_dynamics</name>
  <version>0.1.0</version>
  <description>Self-developed quadrotor rigid-body dynamics node (core exam module). Not based on MARSIM/EGO simulators.</description>
  <maintainer email="student@example.com">drone_ws</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>drone_msgs</depend>
  <depend>eigen</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>drone_controller</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
