<?xml version="1.0"?>
<package format="3">
  <name>gcopter</name>
  <version>0.1.0</version>
  <description>GCOPTER/MINCO planner (Path C) for drone_ws — no SO3 plant</description>
  <maintainer email="wangzhepei@live.com">Zhepei Wang</maintainer>
  <author email="wangzhepei@live.com">Zhepei Wang</author>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>drone_msgs</depend>
  <depend>eigen3_cmake_module</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
