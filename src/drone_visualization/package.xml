<?xml version="1.0"?>
<package format="3">
  <name>drone_visualization</name>
  <version>0.1.0</version>
  <description>RViz2 configuration and quadrotor body marker publisher for drone simulation.</description>
  <maintainer email="student@example.com">drone_ws</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
