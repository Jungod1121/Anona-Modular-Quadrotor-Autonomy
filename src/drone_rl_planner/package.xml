<?xml version="1.0"?>
<package format="3">
  <name>drone_rl_planner</name>
  <version>0.1.0</version>
  <description>Learning-based local trajectory planner (PPO / MAPPO) for the shared drone plant.</description>
  <maintainer email="Jungod1121@users.noreply.github.com">drone_ws</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>drone_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
