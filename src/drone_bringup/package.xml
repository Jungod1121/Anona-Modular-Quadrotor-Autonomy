<?xml version="1.0"?>
<package format="3">
  <name>drone_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files and YAML parameters for six acceptance scenarios.</description>
  <maintainer email="student@example.com">drone_ws</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>drone_msgs</exec_depend>
  <exec_depend>drone_dynamics</exec_depend>
  <exec_depend>drone_controller</exec_depend>
  <exec_depend>drone_map</exec_depend>
  <exec_depend>drone_planner</exec_depend>
  <exec_depend>drone_visualization</exec_depend>
  <exec_depend>drone_exploration</exec_depend>
  <exec_depend>ego_planner</exec_depend>
  <exec_depend>map_generator</exec_depend>
  <exec_depend>mockamap</exec_depend>
  <exec_depend>quadrotor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
